# 复制为 .env（或直接配到 Vercel 环境变量）；.env 不入库

# 音频（155 个 opus）不随前端部署包走；指向托管音频的站点，留空=同源 /audio
PUBLIC_AUDIO_BASE=

# 存储档位：local（同源/PUBLIC_AUDIO_BASE 直链，默认）| s3（S3 兼容私有桶，经 /api/audio-url 预签）
PUBLIC_AUDIO_STORAGE=

# s3 档私有变量（服务端；见 docs/storage-backends.md，Backblaze B2 免费档适用）
AUDIO_S3_ENDPOINT=
AUDIO_S3_REGION=
AUDIO_S3_BUCKET=
AUDIO_S3_ACCESS_KEY_ID=
AUDIO_S3_SECRET_ACCESS_KEY=
AUDIO_S3_KEY_PREFIX=audio/
AUDIO_S3_URL_TTL_SECONDS=3600
AUDIO_S3_PATH_STYLE=0

# 切片素材目录（scripts/build_data.py、scripts/to-opus.sh 读取）
AUDIO_ROOT=<你的切片素材目录>

# 歌名生成模板（scripts/build_data.py 读取）；占位符 {title}{artist}，默认 {title} 与原样一致
SONG_FMT={title}

# B站直播间房间号；不设置则直播间区块不渲染、/api/live 返回 { live: null }
PUBLIC_LIVE_ROOM_ID=<B站房间号>
