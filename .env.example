# Development template only. Never commit actual service addresses or credentials.
# Same implementation on adapter-node / adapter-vercel; persistence adapter only.
CATALOG_STORAGE=local
CATALOG_LOCAL_DIR=YOUR-DATA-DIRECTORY-HERE
# 0 = unlimited; 2 = current business month and immediately preceding month (empty counts).
MAX_QUERY_MONTHS=2
# Blob adapter only; server/publisher private environment.
BLOB_READ_WRITE_TOKEN=
# Optional external audio base. Native backend remains runtime configurable.
PUBLIC_AUDIO_BASE=
PUBLIC_LIVE_ROOM_ID=
# DEPLOY_TARGET=node | vercel | capacitor
BLOB_BASE_URL=
# S3 adapter: CATALOG_STORAGE=s3. All values remain server/publisher-only.
# Optional endpoint: omit for AWS; set for a compatible self-hosted service.
S3_ENDPOINT=YOUR-S3-ENDPOINT-HERE
S3_REGION=YOUR-S3-REGION-HERE
S3_BUCKET=YOUR-S3-BUCKET-HERE
S3_FORCE_PATH_STYLE=true
# Optional safe object prefix, relative segments (letters/digits/_/-), no dots.
S3_PREFIX=YOUR-S3-PREFIX-HERE
S3_ACCESS_KEY_ID=YOUR-S3-ACCESS-KEY-HERE
S3_SECRET_ACCESS_KEY=YOUR-S3-SECRET-KEY-HERE
# Optional temporary credential token
S3_SESSION_TOKEN=
# Optional HTTPS public/CDN base mapping to the bucket root (physical audio key is appended).
S3_AUDIO_PUBLIC_BASE=
# Private single-object GET validity: integer 60..3600 seconds
AUDIO_URL_TTL_SECONDS=900
# Blob store visibility; private requires SDK issueSignedToken + presignUrl.
BLOB_ACCESS=public

# Existing AUDIO_S3_ENDPOINT/REGION/BUCKET/ACCESS_KEY_ID/SECRET_ACCESS_KEY are fallback aliases.
# AUDIO_S3_PATH_STYLE=1|0; AUDIO_S3_URL_TTL_SECONDS; AUDIO_S3_KEY_PREFIX stays filename-only.
# Optional explicit full physical audio prefix; legacy defaults to objects/, not the data prefix.
# S3_AUDIO_KEY_PREFIX=YOUR-AUDIO-PREFIX-HERE/
