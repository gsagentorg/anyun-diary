# Development template only. Never commit actual service addresses or credentials.
# Same implementation on adapter-node / adapter-vercel; persistence adapter only.
CATALOG_STORAGE=local
CATALOG_LOCAL_DIR=YOUR-DATA-DIRECTORY-HERE
# 0 = unlimited; 2 = current business month and immediately preceding month (empty counts).
MAX_QUERY_MONTHS=2
# Blob adapter only; server/publisher private environment.
BLOB_READ_WRITE_TOKEN=
# Optional external audio base. Native backend remains runtime configurable.
PUBLIC_AUDIO_BASE=
PUBLIC_LIVE_ROOM_ID=
# DEPLOY_TARGET=node | vercel | capacitor
BLOB_BASE_URL=
