# 复制为 .env（或直接配到 Vercel 环境变量）；.env 不入库

# 音频（155 个 opus）不随前端部署包走；指向托管音频的站点，留空=同源 /audio
PUBLIC_AUDIO_BASE=

# 仅在一次性迁移命令 audio:migrate 中使用：旧部署的音频基础地址（不带 /audio）
# 未设置 SOURCE_AUDIO_BASE 时，迁移命令使用旧 PUBLIC_AUDIO_BASE。
SOURCE_AUDIO_BASE=

# 仅上传/迁移脚本使用；在 Vercel 创建 Public Blob Store 后获取。不要使用 PUBLIC_ 前缀。
BLOB_READ_WRITE_TOKEN=

# Vercel 内自动识别；本地验证 Vercel 构建时设为 vercel，默认使用 node 自托管。
# DEPLOY_TARGET=vercel

# 切片素材目录（scripts/build_data.py、scripts/to-opus.sh 读取）
AUDIO_ROOT=<你的切片素材目录>

# 歌名生成模板（scripts/build_data.py 读取）；占位符 {title}{artist}，默认 {title} 与原样一致
SONG_FMT={title}

# B站直播间房间号；不设置则直播间区块不渲染、/api/live 返回 { live: null }
PUBLIC_LIVE_ROOM_ID=<B站房间号>
