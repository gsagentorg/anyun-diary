{
  "name": "anyun-diary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check",
    "test": "npm run test:months && npm run test:catalog && npm run test:lyrics && npm run test:playlist && npm run test:shuffle && npm run test:lane-scale && npm run test:session && npm run test:sleep && npm run test:player-ops && npm run test:native-cache && npm run test:ios-cache && npm run test:native-audio && npm run test:brand && npm run test:heatmap && npm run test:architecture && npm run test:interactions && npm run test:migrate-s3 && node scripts/test-queue-budget.mjs",
    "test:lyrics": "vite-node scripts/test-lyrics.mjs",
    "test:playlist": "vite-node scripts/test-playlist.mjs",
    "test:shuffle": "vite-node scripts/test-shuffle.mjs",
    "test:lane-scale": "vite-node scripts/test-lane-scale.mjs",
    "test:session": "vite-node scripts/test-session.mjs",
    "test:sleep": "vite-node scripts/test-sleep.mjs",
    "test:player-ops": "vite-node scripts/test-player-ops.mjs",
    "test:native-cache": "vite-node scripts/test-native-cache.mjs",
    "test:ios-cache": "node scripts/test-ios-cache.mjs",
    "audio:upload": "node scripts/upload-blob.mjs",
    "audio:migrate": "node scripts/upload-blob.mjs --from-remote",
    "test:blob": "node --test scripts/test-upload-blob.mjs",
    "test:storage": "vite-node scripts/test-storage.mjs",
    "icons": "node scripts/sync-app-icon.mjs",
    "prebuild": "npm run icons && node scripts/sync-native-lyrics.mjs",
    "data:publish": "node scripts/publish-data.mjs",
    "brand:publish": "node scripts/publish-brand.mjs",
    "data:rollback": "node scripts/rollback-data.mjs",
    "test:s3": "node scripts/test-s3-storage.mjs && node scripts/test-s3-legacy.mjs",
    "test:native-audio": "vite-node scripts/test-native-audio.mjs",
    "test:architecture": "node scripts/test-architecture.mjs",
    "test:brand": "vite-node scripts/test-brand.mjs",
    "test:heatmap": "vite-node scripts/test-heatmap-domain.mjs",
    "test:months": "node --test src/lib/month-supply.test.js src/lib/month-cache.test.js src/lib/release-supply.test.js",
    "test:catalog": "npm run test:s3 && vite-node scripts/test-audio-renewal.mjs && node scripts/test-audio-delivery.mjs && vite-node scripts/test-s3-application.mjs && python3 scripts/test_derive_catalog.py && node scripts/test-month-storage.mjs && vite-node scripts/test-month-search.mjs",
    "test:interactions": "node scripts/test-interactions.mjs",
    "data:migrate-s3": "node scripts/migrate-s3.mjs",
    "test:migrate-s3": "node scripts/test-migrate-s3.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/adapter-vercel": "^5.10.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@vercel/blob": "^2.8.2",
    "svelte": "^5.38.0",
    "svelte-check": "^4.4.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.0",
    "vite-node": "3.2.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@aws-sdk/s3-request-presigner": "^3.1171.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@vercel/analytics": "^2.0.1",
    "bits-ui": "^2.5.0",
    "lucide-svelte": "^0.545.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": "22.x"
  }
}
